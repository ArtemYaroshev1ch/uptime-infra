# {{ ansible_managed }}
# Application stack of uptime-monitor (ansible/roles/stack, docs/adr/0005).
#
#   sudo docker compose -p {{ stack_project }} ps
#   sudo docker compose -p {{ stack_project }} logs -f api-{{ stack_active_color }}
#
# Only caddy publishes ports (80, 443). Docker writes its own iptables
# rules for published ports and bypasses ufw, so every other port stays
# unpublished: postgres and the ops ports (9090, 9091) are reachable only
# from the Docker networks.
#
# migrate is not started by `up`: Ansible runs it explicitly
# (`docker compose run --rm migrate`) before api and worker, see
# tasks/main.yml.

name: {{ stack_project }}

x-logging: &logging
  driver: json-file
  options:
    max-size: "{{ stack_log_max_size }}"
    max-file: "{{ stack_log_max_file }}"

# Shared by migrate, api-* and worker: the distroless image runs as uid
# 65532, needs no writable files and no Linux capabilities.
x-app: &app
  read_only: true
  cap_drop: [ALL]
  security_opt: [no-new-privileges:true]
  env_file: [env/app.env]
  logging: *logging
  networks: [backend]

services:
  postgres:
    image: {{ stack_postgres_image }}
    # The image's own postgres user: the entrypoint and the server run
    # without root, so no capabilities are needed.
    user: "70:70"
    env_file: [env/postgres.env]
    volumes:
      - pgdata:/var/lib/postgresql/data
    read_only: true
    tmpfs:
      - /tmp
      - /var/run/postgresql
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    healthcheck:
      # $$ escapes Compose interpolation: the variables expand in the
      # container.
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 20s
    mem_limit: {{ stack_limits.postgres.mem }}
    cpus: {{ stack_limits.postgres.cpus }}
    logging: *logging
    networks: [backend]
    restart: unless-stopped

  # One-shot: `docker compose run --rm migrate` (profile keeps it out of
  # `up`, which would start it again on every run).
  migrate:
    <<: *app
    image: {{ stack_app_image }}:{{ app_version }}
    command: ["/app/migrate", "up"]
    profiles: [tools]
    depends_on:
      postgres:
        condition: service_healthy
    mem_limit: {{ stack_limits.migrate.mem }}
    cpus: {{ stack_limits.migrate.cpus }}
    restart: "no"
{% for color, version in stack_api_colors.items() if version %}

  api-{{ color }}:
    <<: *app
    image: {{ stack_app_image }}:{{ version }}
    command: ["/app/api"]
    environment:
      HTTP_ADDR: ":8080"
      OPS_ADDR: ":9090"
      # Behind Caddy: the client IP for the /auth rate limit is the last
      # X-Forwarded-For entry, the one Caddy appends.
      TRUST_PROXY_HEADERS: "true"
    networks: [edge, backend]
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      # No curl in distroless: the binary probes its own /healthz.
      test: ["CMD", "/app/api", "-healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    # SHUTDOWN_TIMEOUT (25 s) stays below it: graceful shutdown finishes.
    stop_grace_period: 30s
    mem_limit: {{ stack_limits.api.mem }}
    cpus: {{ stack_limits.api.cpus }}
    restart: unless-stopped
{% endfor %}

  worker:
    <<: *app
    image: {{ stack_app_image }}:{{ app_version }}
    command: ["/app/worker"]
    environment:
      OPS_ADDR: ":9091"
      WORKER_CONCURRENCY: "{{ stack_app_worker_concurrency }}"
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "/app/worker", "-healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    stop_grace_period: 30s
    mem_limit: {{ stack_limits.worker.mem }}
    cpus: {{ stack_limits.worker.cpus }}
    restart: unless-stopped

  caddy:
    image: {{ stack_caddy_image }}
    # Not root: the namespaced sysctl below lets an unprivileged process
    # bind 80 and 443, so no capability is needed at all.
    user: "65532:65532"
    sysctls:
      net.ipv4.ip_unprivileged_port_start: 0
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      # The directory, not the file: Ansible replaces the Caddyfile
      # atomically (new inode), which a single-file bind mount never sees.
      - ./caddy/etc:/etc/caddy:ro
      - ./caddy/data:/data
      - ./caddy/config:/config
    read_only: true
    tmpfs:
      - /tmp
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    depends_on:
      api-{{ stack_active_color }}:
        condition: service_healthy
    healthcheck:
      # A localhost-only site of the Caddyfile: proves the HTTP server
      # answers, without an access log line every 10 s.
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2020/"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
    mem_limit: {{ stack_limits.caddy.mem }}
    cpus: {{ stack_limits.caddy.cpus }}
    logging: *logging
    networks: [edge]
    restart: unless-stopped

networks:
  # Caddy and the api colors.
  edge: {}
  # api, worker, migrate and postgres. Not `internal`: the worker checks
  # sites on the internet and sends notifications.
  backend: {}

volumes:
  pgdata: {}
