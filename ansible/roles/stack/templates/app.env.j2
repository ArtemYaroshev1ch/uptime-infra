# {{ ansible_managed }}
# Settings and secrets of migrate, api and worker (mode 0600, root only).
APP_ENV=prod
LOG_LEVEL={{ stack_app_log_level }}
DATABASE_URL=postgres://{{ stack_postgres_user | urlencode }}:{{ postgres_password | urlencode }}@postgres:5432/{{ stack_postgres_db }}?sslmode=disable
DB_MAX_CONNS={{ stack_app_db_max_conns }}
JWT_SECRET={{ jwt_secret }}
TELEGRAM_BOT_TOKEN={{ telegram_bot_token | default('') }}
