# --- Terraform -------------------------------------------------------------
# State holds every resource attribute, including secrets: never commit it.
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
.terraform/
# Variable values may contain secrets; only *.tfvars.example is committed.
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# .terraform.lock.hcl IS committed (pinned provider checksums).

# --- Ansible ---------------------------------------------------------------
# The vault password never lives in the repository (docs/operations.md).
.vault-pass
.vault-pass*
*.vault-pass
vault-password*
# Secrets of the local VM, generated by scripts/gen-local-vault.sh
# (docs/adr/0006). Production's encrypted vault.yml is committed.
ansible/inventories/local/group_vars/all/vault.yml
# Generated from `terraform output` by scripts/gen-inventory.sh.
ansible/inventories/prod/hosts.yml
*.retry
.ansible/

# --- Secrets and local environment -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*

# --- Vagrant -----------------------------------------------------------------
.vagrant/
# ssh key pair of the deploy user on the local VM (scripts/with-local-keys.sh).
local/.ssh/
# Root certificate of Caddy's local CA, fetched by `make local-ca`.
local/caddy-root.crt

# --- Go (tools/restore-verifier) ---------------------------------------------
bin/
coverage*.out
coverage*.html

# --- Editors and OS ----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
